{
  "name": "@xnsengo/investia-ui",
  "version": "0.1.0",
  "description": "Investia (ploy-web) React component library with its Storybook: atoms, molecules, organisms, templates and pages.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xnsengo/poly-storybook-demp.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components.css": "./dist/components.css",
    "./styles.css": "./dist/styles.css",
    "./COMPONENTS.md": "./COMPONENTS.md",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "COMPONENTS.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "build": "npm run build:lib && npm run build:css && npm run build:catalog",
    "build:lib": "vite build -c vite.lib.config.ts",
    "build:css": "tailwindcss -i src/styles/package.css -o dist/styles.css --minify",
    "build:catalog": "node scripts/build-catalog.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .storybook scripts src/types src/index.ts vite.lib.config.ts \"src/**/*.stories.tsx\"",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run build-storybook -- --quiet"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "motion": "^12.35.2",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.6.3",
    "globals": "^17.5.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2"
  }
}
